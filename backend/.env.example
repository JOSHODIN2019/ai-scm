# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=ai_scm

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# When true, or when OPENAI_API_KEY is empty, the AI service falls back to
# the mock analyzer instead of calling OpenAI.
USE_MOCK_AI=true

# GitHub (optional -- public repos work unauthenticated)
GITHUB_TOKEN=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
